# Local data sources (use forward slashes on Windows)
OBSIDIAN_VAULT=D:/path/to/your/obsidian-vault
FINANCE_PROJECT=D:/path/to/your/finance-project

# DeepSeek brainstorm
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Leave empty to send no Vault files. Use comma-separated Vault-relative folders.
BRAINSTORM_ALLOW_DIRS=

# Local DailyHotApi service
DAILYHOT_API_URL=http://127.0.0.1:6688