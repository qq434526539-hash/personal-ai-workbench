WORKBENCH_BIND_IP=127.0.0.1
WORKBENCH_PORT=3010
WORKBENCH_DATA_ROOT=./data
WORKBENCH_UID=1000
WORKBENCH_GID=1000

OBSIDIAN_VAULT=/data/vault
FINANCE_PROJECT=/data/finance
WORKBENCH_ALLOWED_HOSTS=localhost,127.0.0.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
BRAINSTORM_ALLOW_DIRS=

# Required for browser uploads and manual social sync. Use a long random value.
WORKBENCH_WRITE_TOKEN=
# Internal Compose-only daily sync token. Use a different long random value.
SOCIAL_SYNC_TOKEN=
WORKBENCH_SYNC_HOST=127.0.0.1

# Account-data endpoints must return JSON. Tokens are optional bearer tokens.
DOUYIN_ACCOUNT_API_URL=
DOUYIN_ACCOUNT_API_TOKEN=
WECHAT_ACCOUNT_API_URL=
WECHAT_ACCOUNT_API_TOKEN=
XIAOHONGSHU_ACCOUNT_API_URL=
XIAOHONGSHU_ACCOUNT_API_TOKEN=
